rules_version = '2';

// Rules tests live in scripts/test-rules.mjs and run against the Firestore
// emulator (`npm run test:rules`). Keep that file in sync with any change here.
// Note: deep per-item validation of identification.secretName/secretDescription within the
// inventoryRecords array is not feasible in Firestore rules. That protection is enforced
// at the model/store layer in src/store/useAppStore.ts.

service cloud.firestore {
  match /databases/{database}/documents {
    match /parties/{partyId} {
      // Read: must be authenticated and a party member. A missing document is
      // readable by any signed-in user so a client can discover it needs to
      // create the party (the id is an unguessable UUID).
      allow read: if request.auth != null
                  && (resource == null || isMember());

      // Create: must be authenticated and creating themselves as GM
      allow create: if request.auth != null
                    && request.resource.data.party.gmUid == request.auth.uid
                    && request.auth.uid in request.resource.data.party.members;

      // Update: GM, a member touching only player-allowed fields, or a
      // non-member joining with the party's invite code.
      allow update: if request.auth != null
                    && (isGm()
                        || (isMember() && isAllowedPlayerUpdate())
                        || isInviteJoin());

      // Delete: only the GM may delete the party document
      allow delete: if isGm();
    }

    // Deny all access to any subcollection paths under parties.
    // This app uses single documents only; this rule is defensive.
    match /parties/{partyId}/{document=**} {
      allow read, write: if false;
    }

    // --- Helper functions ---

    function isMember() {
      return resource.data.party.members != null
        && request.auth.uid in resource.data.party.members;
    }

    function isGm() {
      return request.auth != null
        && resource.data.party.gmUid == request.auth.uid;
    }

    // Players may write the document only if they have not changed any GM-only fields.
    // GM-only party-level fields: party.displayName, party.gmUid, party.members, party.inviteCode
    // Note: nested inventoryRecords secretName/secretDescription cannot be validated
    // per-item in rules — enforced in the app layer instead.
    function isAllowedPlayerUpdate() {
      return request.resource.data.party.gmUid == resource.data.party.gmUid
        && request.resource.data.party.members == resource.data.party.members
        && request.resource.data.party.displayName == resource.data.party.displayName
        && request.resource.data.party.get('inviteCode', null) == resource.data.party.get('inviteCode', null);
    }

    // A signed-in non-member may add exactly one entry — their own uid, as a
    // player — to party.members, and only if that entry carries the party's
    // current invite code. Nothing else in the document may change.
    function isInviteJoin() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let entry = after.party.members[uid];
      return before.party.inviteCode is string
        && before.party.inviteCode.size() >= 8
        && !(uid in before.party.get('members', {}))
        && entry.role == 'player'
        && entry.inviteCode == before.party.inviteCode
        && entry.keys().hasOnly(['role', 'joinedAt', 'inviteCode'])
        && after.diff(before).affectedKeys().hasOnly(['party'])
        && after.party.diff(before.party).affectedKeys().hasOnly(['members'])
        && after.party.members.diff(before.party.get('members', {})).affectedKeys().hasOnly([uid]);
    }
  }
}
